// appHeaders -I. Consumers depend on the ReactAppHeaders product.
let zeroIHeadersTargets: [Target] = zeroI
    ? [
        .target(
            name: "ReactAppHeaders",
            path: "ReactAppHeaders",
            publicHeadersPath: "."
        ),
    ]
    : []
let zeroIHeadersProducts: [Product] = zeroI
    ? [.library(name: "ReactAppHeaders", targets: ["ReactAppHeaders"])]
