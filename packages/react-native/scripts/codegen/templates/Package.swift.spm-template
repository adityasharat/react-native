    : [.headerSearchPath(".."), .headerSearchPath("headers"), .unsafeFlags(rnHeaderCFlags)]
let radpCxxSettings: [CXXSetting] = zeroI
    ? [.headerSearchPath(".."), .headerSearchPath("headers")]
    : [.headerSearchPath(".."), .headerSearchPath("headers"), .unsafeFlags(["-std=c++20"]), .unsafeFlags(rnHeaderCxxFlags)]

